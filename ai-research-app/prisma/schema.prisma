// Prisma Schema for AI Research App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 記事・論文などの情報
model Article {
  id          String   @id @default(cuid())
  title       String
  url         String   @unique
  content     String?  // 本文（オプション）
  summary     String?  // AI生成の要約
  author      String?
  publishedAt DateTime?
  fetchedAt   DateTime @default(now())
  source      String   // 情報源（arXiv, HackerNews, RSS など）
  category    String   // カテゴリ（NLP, CV, RL など）
  tags        Tag[]
  bookmarked  Boolean  @default(false)
  read        Boolean  @default(false)

  @@index([publishedAt])
  @@index([category])
  @@index([source])
}

// タグ
model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  articles Article[]
}

// 情報源の設定
model Source {
  id          String   @id @default(cuid())
  name        String
  type        String   // RSS, API, など
  url         String
  enabled     Boolean  @default(true)
  lastFetched DateTime?

  @@unique([name, type])
}
